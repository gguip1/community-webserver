# Domain / TLS
DOMAIN_NAME=wepick.example.com
ACME_EMAIL=admin@example.com

# Immutable images published by FE/BE CI to GHCR
FE_IMAGE=ghcr.io/w-gain/wepick-fe
FE_IMAGE_TAG=replace-with-frontend-commit-sha
BE_IMAGE=ghcr.io/w-gain/wepick-be
BE_IMAGE_TAG=replace-with-backend-commit-sha

# MySQL — generate unique production values; never commit the real .env file.
MYSQL_DATABASE=wepick
MYSQL_USER=wepick
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
SESSION_COOKIE_SAME_SITE=lax

# Local image storage (Docker volume; values are also injected by Compose)
IMAGE_STORAGE_LOCAL_ROOT=/data/uploads
IMAGE_PUBLIC_PREFIX=/uploads
